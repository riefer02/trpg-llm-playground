# Frontend Environment Variables
# Copy to .env and customize for your environment

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL
# In development: Point directly to FastAPI backend (bypasses TanStack/Nitro)
# In production: Use your deployed backend URL
VITE_API_URL=http://localhost:8000/api

# NOTE: TanStack Start with Nitro intercepts /api/* routes before Vite's proxy
# can forward them. Setting VITE_API_URL directly to the backend is the 
# simplest solution for development with a separate backend.
#
# Alternative: Use createServerFn() to proxy API calls through TanStack's
# server layer. See TanStack Start docs for details.

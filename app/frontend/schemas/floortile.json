{
  "$defs": {
    "HexCoord": {
      "description": "Axial hex coordinate (q, r).\n\nSupports tuple-like comparison and indexing for migration compatibility:\n- h == (x, y) returns True if coordinates match\n- h[0] == h.q, h[1] == h.r\n- hash(h) == hash((x, y))",
      "properties": {
        "q": {
          "description": "Axial q coordinate",
          "title": "Q",
          "type": "integer"
        },
        "r": {
          "description": "Axial r coordinate",
          "title": "R",
          "type": "integer"
        },
        "s": {
          "description": "Derived s coordinate (q + r + s = 0).",
          "readOnly": true,
          "title": "S",
          "type": "integer"
        }
      },
      "required": [
        "q",
        "r",
        "s"
      ],
      "title": "HexCoord",
      "type": "object"
    },
    "MaterialProperties": {
      "description": "Material properties for destructible terrain.\n\nPer PR2 ~4123:\n- Objects have armor 0-4 depending on material type\n- Objects have 10 HP per size\n- Objects have evasion 5",
      "properties": {
        "material_type": {
          "enum": [
            "organic",
            "tough",
            "hardy",
            "fortified",
            "armored"
          ],
          "title": "Material Type",
          "type": "string"
        },
        "armor": {
          "default": 0,
          "maximum": 4,
          "minimum": 0,
          "title": "Armor",
          "type": "integer"
        },
        "hp_per_size": {
          "default": 10,
          "minimum": 1,
          "title": "Hp Per Size",
          "type": "integer"
        },
        "evasion": {
          "default": 5,
          "minimum": 0,
          "title": "Evasion",
          "type": "integer"
        },
        "is_flammable": {
          "default": false,
          "title": "Is Flammable",
          "type": "boolean"
        }
      },
      "required": [
        "material_type"
      ],
      "title": "MaterialProperties",
      "type": "object"
    }
  },
  "description": "Floor tile primitive for normal/difficult/dangerous/climbing terrain.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "floor",
      "default": "floor",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "coords": {
      "items": {
        "$ref": "#/$defs/HexCoord"
      },
      "title": "Coords",
      "type": "array"
    },
    "floor_type": {
      "default": "normal",
      "enum": [
        "normal",
        "difficult",
        "dangerous",
        "climbing"
      ],
      "title": "Floor Type",
      "type": "string"
    },
    "elevation": {
      "default": 0,
      "minimum": 0,
      "title": "Elevation",
      "type": "integer"
    },
    "blocks_line_of_sight": {
      "default": false,
      "title": "Blocks Line Of Sight",
      "type": "boolean"
    },
    "provides_soft_cover": {
      "default": false,
      "title": "Provides Soft Cover",
      "type": "boolean"
    },
    "provides_hard_cover": {
      "default": false,
      "title": "Provides Hard Cover",
      "type": "boolean"
    },
    "hard_cover_size": {
      "anyOf": [
        {
          "enum": [
            "size_half",
            "size_1",
            "size_2",
            "size_3",
            "size_4",
            "size_5"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hard Cover Size"
    },
    "material": {
      "anyOf": [
        {
          "$ref": "#/$defs/MaterialProperties"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "zone_type": {
      "anyOf": [
        {
          "enum": [
            "deployment",
            "extraction",
            "objective",
            "ingress"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Zone Type"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "FloorTile",
  "type": "object"
}
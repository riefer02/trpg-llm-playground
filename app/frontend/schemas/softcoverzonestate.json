{
  "$defs": {
    "HexCoord": {
      "description": "Axial hex coordinate (q, r).\n\nSupports tuple-like comparison and indexing for migration compatibility:\n- h == (x, y) returns True if coordinates match\n- h[0] == h.q, h[1] == h.r\n- hash(h) == hash((x, y))",
      "properties": {
        "q": {
          "description": "Axial q coordinate",
          "title": "Q",
          "type": "integer"
        },
        "r": {
          "description": "Axial r coordinate",
          "title": "R",
          "type": "integer"
        },
        "s": {
          "description": "Derived s coordinate (q + r + s = 0).",
          "readOnly": true,
          "title": "S",
          "type": "integer"
        }
      },
      "required": [
        "q",
        "r",
        "s"
      ],
      "title": "HexCoord",
      "type": "object"
    }
  },
  "description": "Runtime state for a soft cover zone with duration tracking.\n\nUsed for smoke clouds, foliage areas, and other zones that provide\nsoft cover for hiding but may expire after a set number of rounds.",
  "properties": {
    "zone_id": {
      "title": "Zone Id",
      "type": "string"
    },
    "coords": {
      "items": {
        "$ref": "#/$defs/HexCoord"
      },
      "title": "Coords",
      "type": "array",
      "uniqueItems": true
    },
    "zone_subtype": {
      "title": "Zone Subtype",
      "type": "string"
    },
    "created_round": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created Round"
    },
    "duration_rounds": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Rounds"
    }
  },
  "required": [
    "zone_id",
    "coords",
    "zone_subtype"
  ],
  "title": "SoftCoverZoneState",
  "type": "object"
}
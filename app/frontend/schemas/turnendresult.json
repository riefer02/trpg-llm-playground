{
  "$defs": {
    "BurnTickResult": {
      "description": "Result of burn damage tick at end of turn.",
      "properties": {
        "target_id": {
          "description": "Combatant who took the burn tick",
          "title": "Target Id",
          "type": "string"
        },
        "burn_amount": {
          "description": "Total burn marked before resolution",
          "title": "Burn Amount",
          "type": "integer"
        },
        "engineering_roll": {
          "description": "1d20 roll",
          "title": "Engineering Roll",
          "type": "integer"
        },
        "engineering_bonus": {
          "description": "Engineering skill bonus",
          "title": "Engineering Bonus",
          "type": "integer"
        },
        "total": {
          "description": "Roll + bonus",
          "title": "Total",
          "type": "integer"
        },
        "dc": {
          "default": 10,
          "description": "Difficulty class (always 10)",
          "title": "Dc",
          "type": "integer"
        },
        "success": {
          "description": "Whether check succeeded",
          "title": "Success",
          "type": "boolean"
        },
        "damage_taken": {
          "default": 0,
          "description": "Damage taken (0 if success)",
          "title": "Damage Taken",
          "type": "integer"
        },
        "burn_cleared": {
          "description": "Whether burn was cleared",
          "title": "Burn Cleared",
          "type": "boolean"
        }
      },
      "required": [
        "target_id",
        "burn_amount",
        "engineering_roll",
        "engineering_bonus",
        "total",
        "success",
        "burn_cleared"
      ],
      "title": "BurnTickResult",
      "type": "object"
    }
  },
  "description": "Result of ending a combatant's turn.",
  "properties": {
    "actor_id": {
      "description": "ID of the actor whose turn ended",
      "title": "Actor Id",
      "type": "string"
    },
    "next_actor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ID of next actor, None if round ends",
      "title": "Next Actor Id"
    },
    "next_actor_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Name of next actor",
      "title": "Next Actor Name"
    },
    "round_advanced": {
      "default": false,
      "description": "Whether we advanced to a new round",
      "title": "Round Advanced",
      "type": "boolean"
    },
    "new_round_number": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "New round number if advanced",
      "title": "New Round Number"
    },
    "end_of_turn_effects": {
      "description": "Effects applied at turn end",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "End Of Turn Effects",
      "type": "array"
    },
    "cooldowns_decremented": {
      "description": "Effect IDs whose cooldowns were decremented",
      "items": {
        "type": "string"
      },
      "title": "Cooldowns Decremented",
      "type": "array"
    },
    "burn_tick_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/BurnTickResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Burn tick resolution if actor had burn"
    },
    "drones_primed": {
      "description": "IDs of drones that primed at end of this turn",
      "items": {
        "type": "string"
      },
      "title": "Drones Primed",
      "type": "array"
    },
    "fall_resolved": {
      "default": false,
      "description": "Whether a fall was resolved this turn",
      "title": "Fall Resolved",
      "type": "boolean"
    },
    "fall_damage": {
      "default": 0,
      "description": "Damage taken from fall (1 per altitude level, armor-piercing)",
      "title": "Fall Damage",
      "type": "integer"
    },
    "fell_from_altitude": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Altitude level the actor fell from",
      "title": "Fell From Altitude"
    }
  },
  "required": [
    "actor_id"
  ],
  "title": "TurnEndResult",
  "type": "object"
}
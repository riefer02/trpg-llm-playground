{
  "$defs": {
    "FullTechOptionSelection": {
      "description": "Minimal selection for a Full Tech option (option + target).",
      "properties": {
        "option": {
          "enum": [
            "scan",
            "bolster",
            "lock_on",
            "invade"
          ],
          "title": "Option",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "scan_options": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "stats",
                  "hidden_info",
                  "public_info"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Options"
        }
      },
      "required": [
        "option",
        "target_id"
      ],
      "title": "FullTechOptionSelection",
      "type": "object"
    },
    "HexCoord": {
      "description": "Axial hex coordinate (q, r).\n\nSupports tuple-like comparison and indexing for migration compatibility:\n- h == (x, y) returns True if coordinates match\n- h[0] == h.q, h[1] == h.r\n- hash(h) == hash((x, y))",
      "properties": {
        "q": {
          "description": "Axial q coordinate",
          "title": "Q",
          "type": "integer"
        },
        "r": {
          "description": "Axial r coordinate",
          "title": "R",
          "type": "integer"
        },
        "s": {
          "description": "Derived s coordinate (q + r + s = 0).",
          "readOnly": true,
          "title": "S",
          "type": "integer"
        }
      },
      "required": [
        "q",
        "r",
        "s"
      ],
      "title": "HexCoord",
      "type": "object"
    },
    "HexPosition": {
      "description": "Hex position with optional elevation.",
      "properties": {
        "coord": {
          "$ref": "#/$defs/HexCoord"
        },
        "elevation": {
          "default": 0,
          "description": "Vertical elevation in spaces",
          "minimum": 0,
          "title": "Elevation",
          "type": "integer"
        }
      },
      "required": [
        "coord"
      ],
      "title": "HexPosition",
      "type": "object"
    }
  },
  "description": "Input for executing a combat action.",
  "properties": {
    "actor_id": {
      "description": "ID of the combatant taking action",
      "title": "Actor Id",
      "type": "string"
    },
    "action_id": {
      "description": "Action identifier (e.g., 'skirmish', 'barrage')",
      "title": "Action Id",
      "type": "string"
    },
    "action_type": {
      "description": "Type of action",
      "enum": [
        "free",
        "quick",
        "full",
        "reaction",
        "protocol",
        "move"
      ],
      "title": "Action Type",
      "type": "string"
    },
    "target_ids": {
      "description": "Target combatant IDs",
      "items": {
        "type": "string"
      },
      "title": "Target Ids",
      "type": "array"
    },
    "target_position": {
      "anyOf": [
        {
          "$ref": "#/$defs/HexPosition"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Target position for area/movement"
    },
    "weapon_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Weapon being used",
      "title": "Weapon Id"
    },
    "weapon_profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Weapon profile to use for weapons with multiple profiles (e.g., kinetic/energy/explosive)",
      "title": "Weapon Profile Id"
    },
    "system_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "System being activated",
      "title": "System Id"
    },
    "full_tech_first": {
      "anyOf": [
        {
          "$ref": "#/$defs/FullTechOptionSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "First Full Tech option selection"
    },
    "full_tech_second": {
      "anyOf": [
        {
          "$ref": "#/$defs/FullTechOptionSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Second Full Tech option selection"
    },
    "movement_path": {
      "description": "Movement path for move actions",
      "items": {
        "$ref": "#/$defs/HexPosition"
      },
      "title": "Movement Path",
      "type": "array"
    },
    "is_overcharge": {
      "default": false,
      "description": "Whether this action uses overcharge",
      "title": "Is Overcharge",
      "type": "boolean"
    },
    "granted_by_overcharge": {
      "default": false,
      "description": "Whether this action was granted by overcharge",
      "title": "Granted By Overcharge",
      "type": "boolean"
    },
    "stabilize_primary": {
      "anyOf": [
        {
          "enum": [
            "cool_heat",
            "spend_repair_full_hp",
            "cancel_meltdown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Primary stabilize option: cool heat OR spend repair for full HP",
      "title": "Stabilize Primary"
    },
    "stabilize_secondary": {
      "anyOf": [
        {
          "enum": [
            "reload_loading",
            "clear_burn",
            "clear_condition"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Secondary stabilize option: reload/clear burn/clear condition",
      "title": "Stabilize Secondary"
    },
    "apply_knockback": {
      "default": true,
      "description": "Whether to apply knockback on successful ram",
      "title": "Apply Knockback",
      "type": "boolean"
    },
    "use_thrown": {
      "default": false,
      "description": "Whether to treat a melee weapon attack as thrown (uses thrown range, applies cover, disarms weapon)",
      "title": "Use Thrown",
      "type": "boolean"
    },
    "eject_direction": {
      "anyOf": [
        {
          "$ref": "#/$defs/HexCoord"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Direction for eject (pilot flies 6 spaces in this direction)"
    },
    "deploy_kind": {
      "anyOf": [
        {
          "enum": [
            "drone",
            "mine",
            "deployable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Kind of deployable to create",
      "title": "Deploy Kind"
    },
    "deploy_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Name for the deployed entity",
      "title": "Deploy Name"
    },
    "mine_type": {
      "anyOf": [
        {
          "enum": [
            "explosive",
            "shroud",
            "breaching",
            "cluster",
            "emp"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Type of mine being deployed",
      "title": "Mine Type"
    }
  },
  "required": [
    "actor_id",
    "action_id",
    "action_type"
  ],
  "title": "ActionExecutionInput",
  "type": "object"
}
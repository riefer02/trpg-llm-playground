        "wedge",
        "axis"
      ],
      "title": "Cone Mode",
      "type": "string"
    },
    "separate_attack_per_target": {
      "default": true,
      "title": "Separate Attack Per Target",
      "type": "boolean"
    },
    "single_damage_roll": {
      "default": true,
      "title": "Single Damage Roll",
      "type": "boolean"
    }
  },
  "required": [
    "pattern",
    "size"
  ],
  "title": "AttackPatternDefinition",
  "type": "object"
}
          "const": "evasion",
          "default": "evasion",
          "title": "Ranged Target Stat",
          "type": "string"
        },
        "tech_target_stat": {
          "const": "e_defense",
          "default": "e_defense",
          "title": "Tech Target Stat",
          "type": "string"
        },
        "ranged_engaged_difficulty": {
          "default": 1,
          "minimum": 0,
          "title": "Ranged Engaged Difficulty",
          "type": "integer"
        }
      },
      "title": "AttackRules",
      "type": "object"
    },
    "BonusDamageRules": {

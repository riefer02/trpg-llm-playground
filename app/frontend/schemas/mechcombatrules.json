          "type": "boolean"
        },
        "knockback_stops_at_obstruction": {
          "default": true,
          "title": "Knockback Stops At Obstruction",
          "type": "boolean"
        },
        "no_vertical_movement": {
          "default": true,
          "title": "No Vertical Movement",
          "type": "boolean"
        }

        "full_actions_per_turn": {
          "default": 1,
          "minimum": 0,
          "title": "Full Actions Per Turn",
          "type": "integer"
        },
        "allows_duplicate_actions": {
          "default": false,
          "title": "Allows Duplicate Actions",
          "type": "boolean"
        },
        "duplicate_requires_free_action": {
          "default": true,
          "title": "Duplicate Requires Free Action",
          "type": "boolean"
        }
      },
      "title": "ActionEconomyRules",
      "type": "object"
    },
    "AttackRules": {
      "description": "Attack targeting rules.",
      "properties": {
        "melee_target_stat": {
          "const": "evasion",

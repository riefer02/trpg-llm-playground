          "type": "boolean"
        },
        "slowed_while_dragging": {
          "default": true,
          "title": "Slowed While Dragging",
          "type": "boolean"
        },
        "immobilized_while_lifting": {
          "default": true,
          "title": "Immobilized While Lifting",
          "type": "boolean"
        }

    "GrappleRules": {
      "description": "Grapple-specific rules per PR2 ~4157-4177.\n\n- Grapple is a quick action melee attack\n- On hit: both parties become engaged\n- Smaller party is immobilized, moves when larger moves\n- Same size = contested HULL check at start of turn\n- Grapple breaks if adjacency breaks (e.g., knockback)\n- Attacker ends free action, defender ends via quick action contested check",
      "properties": {
        "immobilized_for_smaller": {
          "default": true,
          "title": "Immobilized For Smaller",
          "type": "boolean"
        },
        "contested_hull_check_for_same_size": {
          "default": true,
          "title": "Contested Hull Check For Same Size",
          "type": "boolean"
        },
        "attacker_ends_free": {
          "default": true,
          "title": "Attacker Ends Free",
          "type": "boolean"
        },
        "defender_ends_quick_action": {
          "default": true,
          "title": "Defender Ends Quick Action",
          "type": "boolean"
        },
        "break_on_knockback": {
          "default": true,
          "title": "Break On Knockback",
          "type": "boolean"
        },
        "break_on_loss_of_adjacency": {
          "default": true,
          "title": "Break On Loss Of Adjacency",
          "type": "boolean"
        },
        "group_grapple_size_calculation": {
          "default": true,
          "title": "Group Grapple Size Calculation",
          "type": "boolean"
        },
        "mount_required_for_grapple": {
          "default": true,
          "title": "Mount Required For Grapple",
          "type": "boolean"
        },
        "disarm_on_grapple": {
          "default": true,
          "title": "Disarm On Grapple",
          "type": "boolean"
        }
      },
      "title": "GrappleRules",
      "type": "object"
    },

{
  "$defs": {
    "InstalledSystem": {
      "description": "System installed on a mech.",
      "properties": {
        "system_id": {
          "title": "System Id",
          "type": "string"
        },
        "sp_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sp Cost"
        }
      },
      "required": [
        "system_id"
      ],
      "title": "InstalledSystem",
      "type": "object"
    },
    "MechBuild": {
      "description": "A mech build derived from a frame and loadout.",
      "properties": {
        "frame_id": {
          "title": "Frame Id",
          "type": "string"
        },
        "weapons": {
          "items": {
            "$ref": "#/$defs/MountedWeapon"
          },
          "title": "Weapons",
          "type": "array"
        },
        "systems": {
          "items": {
            "$ref": "#/$defs/InstalledSystem"
          },
          "title": "Systems",
          "type": "array"
        }
      },
      "required": [
        "frame_id"
      ],
      "title": "MechBuild",
      "type": "object"
    },
    "MechDamageState": {
      "description": "Damage state for a mech between combats.\n\nTracks current resource levels and destroyed components.\nDefault values represent a fully healthy mech (full HP, structure, stress,\nno destroyed components).",
      "properties": {
        "hp_current": {
          "description": "Current HP",
          "minimum": 0,
          "title": "Hp Current",
          "type": "integer"
        },
        "structure_current": {
          "description": "Current structure (0-4)",
          "maximum": 4,
          "minimum": 0,
          "title": "Structure Current",
          "type": "integer"
        },
        "stress_current": {
          "description": "Current reactor stress",
          "minimum": 0,
          "title": "Stress Current",
          "type": "integer"
        },
        "destroyed_weapons": {
          "description": "Weapon IDs that are destroyed and need repair",
          "items": {
            "type": "string"
          },
          "title": "Destroyed Weapons",
          "type": "array"
        },
        "destroyed_systems": {
          "description": "System IDs that are destroyed and need repair",
          "items": {
            "type": "string"
          },
          "title": "Destroyed Systems",
          "type": "array"
        },
        "is_destroyed": {
          "default": false,
          "description": "Whether the mech is completely destroyed (wreck)",
          "title": "Is Destroyed",
          "type": "boolean"
        }
      },
      "required": [
        "hp_current",
        "structure_current",
        "stress_current"
      ],
      "title": "MechDamageState",
      "type": "object"
    },
    "MountedWeapon": {
      "description": "Weapon installed on a specific mount slot.",
      "properties": {
        "mount_index": {
          "minimum": 0,
          "title": "Mount Index",
          "type": "integer"
        },
        "weapon_id": {
          "title": "Weapon Id",
          "type": "string"
        },
        "weapon_size": {
          "enum": [
            "aux",
            "main",
            "heavy",
            "superheavy"
          ],
          "title": "Weapon Size",
          "type": "string"
        }
      },
      "required": [
        "mount_index",
        "weapon_id",
        "weapon_size"
      ],
      "title": "MountedWeapon",
      "type": "object"
    }
  },
  "description": "A named mech loadout owned by a character.\n\nRepresents a single mech configuration that a pilot can use.\nThe actual combat stats are computed based on the pilot's skills,\ngrit, and core bonuses when accessed through the Character model.",
  "properties": {
    "id": {
      "description": "Unique mech configuration ID",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "description": "Custom name (e.g., 'RAIJIN')",
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "frame_id": {
      "description": "Frame definition ID",
      "title": "Frame Id",
      "type": "string"
    },
    "build": {
      "$ref": "#/$defs/MechBuild",
      "description": "Weapon and system loadout"
    },
    "damage_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/MechDamageState"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Current damage state (None = full health)"
    }
  },
  "required": [
    "id",
    "name",
    "frame_id"
  ],
  "title": "MechConfiguration",
  "type": "object"
}
{
  "$defs": {
    "DiceExpression": {
      "description": "Represents a dice expression like \"1d6\", \"2d6+2\", or \"1d20\".\n\nLancer primarily uses d6 and d20:\n- d20 for skill checks (roll high)\n- d6 for damage (1d6 per damage die)\n- d3 rarely used (typically 1d6/2)",
      "properties": {
        "count": {
          "default": 1,
          "title": "Count",
          "type": "integer"
        },
        "size": {
          "default": 6,
          "enum": [
            3,
            6,
            20
          ],
          "title": "Size",
          "type": "integer"
        },
        "modifier": {
          "default": 0,
          "title": "Modifier",
          "type": "integer"
        }
      },
      "title": "DiceExpression",
      "type": "object"
    }
  },
  "description": "Dynamic profile rule for the Mimic Gun.",
  "properties": {
    "roll_expression": {
      "$ref": "#/$defs/DiceExpression",
      "description": "Roll used for each mimic value"
    },
    "roll_count": {
      "default": 3,
      "minimum": 1,
      "title": "Roll Count",
      "type": "integer"
    },
    "cycle_on": {
      "const": "turn_start",
      "default": "turn_start",
      "title": "Cycle On",
      "type": "string"
    },
    "range_from_roll": {
      "default": true,
      "title": "Range From Roll",
      "type": "boolean"
    },
    "damage_divisor": {
      "default": 2,
      "minimum": 1,
      "title": "Damage Divisor",
      "type": "integer"
    },
    "damage_rounding": {
      "default": "up",
      "enum": [
        "up",
        "down"
      ],
      "title": "Damage Rounding",
      "type": "string"
    },
    "damage_bonus": {
      "default": 1,
      "minimum": 0,
      "title": "Damage Bonus",
      "type": "integer"
    },
    "reroll_action_type": {
      "const": "full",
      "default": "full",
      "title": "Reroll Action Type",
      "type": "string"
    }
  },
  "title": "MimicGunProfileRule",
  "type": "object"
}
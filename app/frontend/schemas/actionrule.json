        "attacker_end_free_action": {
          "default": true,
          "title": "Attacker End Free Action",
          "type": "boolean"
        },
        "defender_end_quick_action": {
          "default": true,
          "title": "Defender End Quick Action",
          "type": "boolean"
        },
        "defender_contested_hull": {
          "default": true,
          "title": "Defender Contested Hull",
          "type": "boolean"
        },
        "equal_size_contested_hull_each_turn": {
          "default": true,
          "title": "Equal Size Contested Hull Each Turn",
          "type": "boolean"
        }

        "resist_all_damage_from_trigger": {
          "default": true,
          "title": "Resist All Damage From Trigger",
          "type": "boolean"
        },
        "resist_heat_from_trigger": {
          "default": true,
          "title": "Resist Heat From Trigger",
          "type": "boolean"
        },
        "resist_burn_from_trigger": {
          "default": true,
          "title": "Resist Burn From Trigger",
          "type": "boolean"
        }
      },
      "title": "BraceRule",
      "type": "object"
    },
    "ContestedCheckRule": {
      "description": "Contested check definition for an action.",
      "properties": {
        "attacker_stat": {
          "enum": [
            "systems",
            "agility",
            "skill_check"
          ],
          "title": "Attacker Stat",
          "type": "string"
        },
        "defender_stat": {
          "enum": [
            "systems",
            "agility",
            "skill_check"
          ],
          "title": "Defender Stat",
          "type": "string"
        },
        "tie_breaker": {
          "default": "attacker",
          "enum": [
            "attacker",
            "defender"
          ],
          "title": "Tie Breaker",
          "type": "string"
        }
      },
      "required": [
        "attacker_stat",
        "defender_stat"
      ],
      "title": "ContestedCheckRule",
      "type": "object"
    },
    "DiceExpression": {
      "description": "Represents a dice expression like \"1d6\", \"2d6+2\", or \"1d20\".\n\nLancer primarily uses d6 and d20:\n- d20 for skill checks (roll high)\n- d6 for damage (1d6 per damage die)\n- d3 rarely used (typically 1d6/2)",
      "properties": {
        "count": {
          "default": 1,
          "title": "Count",
          "type": "integer"
        },
        "size": {
          "default": 6,
          "enum": [
            3,
            6,
            20
          ],
          "title": "Size",
          "type": "integer"
        },
        "modifier": {
          "default": 0,
          "title": "Modifier",
          "type": "integer"
        }
      },
      "title": "DiceExpression",
      "type": "object"
    },
    "FightRule": {
      "description": "Pilot fight action rule.",
      "properties": {
        "uses_pilot_weapon": {
          "default": true,
          "title": "Uses Pilot Weapon",
          "type": "boolean"
        },
        "sidearm_can_be_quick": {
          "default": true,
          "title": "Sidearm Can Be Quick",
          "type": "boolean"
        }
      },
      "title": "FightRule",
      "type": "object"
    },
    "GrappleRule": {
      "description": "Grapple-specific restrictions.",

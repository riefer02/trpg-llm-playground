{
  "$defs": {
    "AttackActionProfile": {
      "description": "Attack profile for an action.",
      "properties": {
        "attack_type": {
          "anyOf": [
            {
              "enum": [
                "melee",
                "ranged",
                "tech"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attack Type"
        },
        "attack_type_follows_weapon": {
          "default": false,
          "title": "Attack Type Follows Weapon",
          "type": "boolean"
        },
        "uses_weapon": {
          "default": true,
          "title": "Uses Weapon",
          "type": "boolean"
        },
        "weapon_count": {
          "default": 1,
          "minimum": 1,
          "title": "Weapon Count",
          "type": "integer"
        },
        "allow_superheavy": {
          "default": true,
          "title": "Allow Superheavy",
          "type": "boolean"
        },
        "allow_aux_bonus_attack": {
          "default": false,
          "title": "Allow Aux Bonus Attack",
          "type": "boolean"
        },
        "aux_cannot_bonus_damage": {
          "default": false,
          "title": "Aux Cannot Bonus Damage",
          "type": "boolean"
        },
        "ignores_cover": {
          "default": false,
          "title": "Ignores Cover",
          "type": "boolean"
        },
        "fixed_damage": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiceExpression"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "on_hit_statuses": {
          "items": {
            "enum": [
              "braced",
              "immobilized",
              "impaired",
              "jammed",
              "lock_on",
              "shredded",
              "slowed",
              "stunned",
              "prone",
              "hidden",
              "invisible",
              "shutdown",
              "exposed",
              "engaged",
              "burn",
              "unshackled",
              "falling"
            ],
            "type": "string"
          },
          "title": "On Hit Statuses",
          "type": "array"
        },
        "knockback_spaces": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knockback Spaces"
        }
      },
      "title": "AttackActionProfile",
      "type": "object"
    },
    "BootUpRule": {
      "description": "Boot up action effect.",
      "properties": {
        "clears_status": {
          "default": "shutdown",
          "enum": [
            "braced",
            "immobilized",
            "impaired",
            "jammed",
            "lock_on",
            "shredded",
            "slowed",
            "stunned",
            "prone",
            "hidden",
            "invisible",
            "shutdown",
            "exposed",

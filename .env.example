# Lancer Web Application Environment Variables
# Copy this file to .env and customize as needed

# =============================================================================
# Backend Configuration
# =============================================================================

# Database connection (using port 5433 to avoid conflicts)
DATABASE_URL=postgresql+asyncpg://lancer:lancer@localhost:5433/lancer

# Debug mode (enables API docs, verbose logging)
DEBUG=true

# CORS origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Frontend Configuration
# =============================================================================

# API base URL
VITE_API_URL=http://localhost:8000/api

# WebSocket URL (for future real-time features)
VITE_WS_URL=ws://localhost:8000/api

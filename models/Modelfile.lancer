# Lancer RPG Expert - Ollama Modelfile
# 
# Usage:
#   1. Download your GGUF to this folder (models/)
#   2. Update the FROM line below with your filename
#   3. Run: ollama create lancer-expert -f models/Modelfile.lancer
#   4. Test: ollama run lancer-expert "How does Overcharge work?"

FROM ./qwen-lancer-7b-q4_k_m.gguf

# Generation parameters
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.1
PARAMETER num_predict 512
PARAMETER stop "<|im_end|>"
PARAMETER stop "<|endoftext|>"

# No SYSTEM prompt here - let the RAG script provide context dynamically
# The fine-tuned model already knows it's a Lancer expert

